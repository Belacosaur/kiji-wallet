// Sophia NFT minimum interface if protocol-native entries are insufficient.
// Do not treat this as the canonical Gajumaru NFT standard yet.

contract GajuNft =
  record meta = { uri : string, content_hash : hash }

  stateful entrypoint mint(to : address, token_id : int, meta : meta) : unit
  stateful entrypoint burn(token_id : int) : unit
  stateful entrypoint transfer(to : address, token_id : int) : unit
  entrypoint owner_of(token_id : int) : address
  entrypoint metadata(token_id : int) : meta
  entrypoint balance_of(owner : address) : int
